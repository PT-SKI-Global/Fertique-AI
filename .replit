modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales"]

[deployment]
deploymentTarget = "gce"
publicDir = "/"
run = ["sh", "-c", "streamlit run app_agribusiness.py --server.port 5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AgriBiz AI - Full Platform"

[[workflows.workflow]]
name = "AgriBiz AI - Full Platform"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app_agribusiness.py --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 36055
externalPort = 3000

[[ports]]
localPort = 42245
externalPort = 3001

[[ports]]
localPort = 45665
externalPort = 3002
